<Window x:Class="FindLargeFiles.TranslationHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FindLargeFiles.Localization"
        Title="{l:Tr translation_hint.title}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <StackPanel>
            <DockPanel Height="56" Margin="24,0,8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" IsCancel="True"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:Tr global.close}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xF2B7;" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{l:Tr translation_hint.title}" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />

            <StackPanel Margin="24,18,24,0">
                <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr translation_hint.message}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16" />

                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" /></Border>
                    <TextBlock x:Name="StepCreateText" TextWrapping="Wrap" />
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" /></Border>
                    <TextBlock x:Name="StepTranslateText" TextWrapping="Wrap" />
                </DockPanel>
                <DockPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" /></Border>
                    <TextBlock Text="{l:Tr translation_hint.step_restart}" TextWrapping="Wrap" />
                </DockPanel>

                <TextBlock Text="{l:Tr translation_hint.folder_label}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <Border Background="{StaticResource WindowBrush}" CornerRadius="6" Padding="10,7">
                    <TextBlock x:Name="FolderText" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="CreatedText" Foreground="{StaticResource AccentHoverBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <Border Margin="0,18,0,0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="OnCreate" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Tr translation_hint.create_file}" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="{l:Tr translation_hint.open_folder}" Click="OnOpenFolder" Margin="8,0,0,0" />
                    <Button Style="{StaticResource OutlineButton}" Content="{l:Tr translation_hint.dismiss}" IsDefault="True" IsCancel="True" HorizontalAlignment="Left" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
