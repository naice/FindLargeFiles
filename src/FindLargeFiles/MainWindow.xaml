<Window x:Class="FindLargeFiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FindLargeFiles"
        xmlns:vm="clr-namespace:FindLargeFiles.ViewModels"
        xmlns:controls="clr-namespace:FindLargeFiles.Controls"
        xmlns:behaviors="clr-namespace:FindLargeFiles.Behaviors"
        xmlns:l="clr-namespace:FindLargeFiles.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="FindLargeFiles" Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="F5" Command="{Binding RescanCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportReportCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <local:EqualsConverter x:Key="Equals" />
        <local:VisibilityConverter x:Key="Visible" />
        <local:VisibilityConverter x:Key="Hidden" Invert="True" />
        <local:FractionWidthConverter x:Key="FractionWidth" />
        <local:RowIconGlyphConverter x:Key="IconGlyph" />
        <local:RowIconBrushConverter x:Key="IconBrush" Folder="{StaticResource FolderBrush}" File="{StaticResource TextMutedBrush}"
                                     Drive="{StaticResource AccentHoverBrush}" Warning="{StaticResource WarningBrush}" />
        <local:LevelBrushConverter x:Key="LevelBrush" Normal="{StaticResource DataBrush}" Warning="{StaticResource WarningBrush}"
                                   Critical="{StaticResource CriticalBrush}" />

        <!-- Horizontal share bar used in several lists -->
        <DataTemplate x:Key="ShareBar">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="52" TextAlignment="Right" Text="{Binding ShareText}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <Grid x:Name="Track" Height="6" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Border Background="{StaticResource TrackBrush}" CornerRadius="3" />
                    <Border Background="{StaticResource DataBrush}" CornerRadius="3" HorizontalAlignment="Left">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource FractionWidth}">
                                <Binding Path="Share" />
                                <Binding Path="ActualWidth" ElementName="Track" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="{l:Tr context_menu.open}" InputGestureText="{l:Tr global.shortcut_enter}" Command="{Binding OpenItemCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Tr context_menu.show_in_explorer}" Command="{Binding ShowInExplorerCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Tr context_menu.copy_path}" Command="{Binding CopyPathCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:Tr context_menu.scan_only_this}" Command="{Binding ScopeToCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE71E;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Tr context_menu.rescan_folder}" InputGestureText="{l:Tr global.shortcut_refresh}" Command="{Binding RescanCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Tr context_menu.report_for_folder}" InputGestureText="{l:Tr global.shortcut_export}" Command="{Binding ExportReportCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:Tr context_menu.move_to_recycle_bin}" InputGestureText="{l:Tr global.shortcut_delete}" Command="{Binding RecycleCommand}"
                      Foreground="{StaticResource DangerBrush}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:Tr context_menu.properties}" Command="{Binding ShowPropertiesCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═════════════ Sidebar ═════════════ -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Image Source="Resources/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="FindLargeFiles" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="10,6,10,0">
                        <Button Style="{StaticResource NavButton}" Command="{Binding OpenFolderCommand}" ToolTip="{l:Tr sidebar.scan_folder_tooltip}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Foreground="{StaticResource TextSecondaryBrush}" Width="24" />
                                <TextBlock DockPanel.Dock="Right" Text="{l:Tr global.shortcut_open}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr sidebar.scan_folder}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding RescanCommand}" IsEnabled="{Binding HasResult}"
                                ToolTip="{l:Tr sidebar.refresh_tooltip}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Foreground="{StaticResource TextSecondaryBrush}" Width="24" />
                                <TextBlock DockPanel.Dock="Right" Text="{l:Tr global.shortcut_refresh}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr sidebar.refresh}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding ExportReportCommand}" IsEnabled="{Binding HasResult}"
                                ToolTip="{l:Tr sidebar.export_report_tooltip}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource TextSecondaryBrush}" Width="24" />
                                <TextBlock DockPanel.Dock="Right" Text="{l:Tr global.shortcut_export}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr sidebar.export_report}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <DockPanel Grid.Row="2" Margin="20,18,12,6">
                        <!-- The refresh button turns into a spinner while drives are still answering. -->
                        <Grid DockPanel.Dock="Right" Width="24" Height="24">
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11"
                                    Content="&#xE72C;" Command="{Binding RefreshDrivesCommand}" ToolTip="{l:Tr drives.refresh_tooltip}"
                                    Visibility="{Binding IsLoadingDrives, Converter={StaticResource Hidden}}" />
                            <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" Background="Transparent"
                                            ToolTip="{l:Tr drives.loading_tooltip}"
                                            Visibility="{Binding IsLoadingDrives, Converter={StaticResource Visible}}" />
                        </Grid>
                        <TextBlock Text="{l:Tr drives.title}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="10,0">
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DriveItem">
                                    <Button Style="{StaticResource NavButton}" Padding="10,9" Margin="0,2"
                                            Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding ToolTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="18" VerticalAlignment="Top" Margin="0,1,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsedShareText}" FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Letter, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <Grid x:Name="Track" Height="4" Margin="0,7,0,6">
                                                    <Border Background="{StaticResource TrackBrush}" CornerRadius="2" />
                                                    <Border CornerRadius="2" HorizontalAlignment="Left"
                                                            Background="{Binding Level, Converter={StaticResource LevelBrush}}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource FractionWidth}">
                                                                <Binding Path="UsedShare" />
                                                                <Binding Path="ActualWidth" ElementName="Track" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding SpaceText}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Margin="10,8,10,12">
                        <Button Style="{StaticResource NavButton}" Command="{Binding RestartAsAdminCommand}"
                                Visibility="{Binding IsElevated, Converter={StaticResource Hidden}}"
                                ToolTip="{l:Tr sidebar.restart_as_admin_tooltip}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{StaticResource WarningBrush}" Width="24" />
                                <TextBlock Text="{l:Tr sidebar.restart_as_admin}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <TextBlock Margin="10,6,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding VersionText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════════ Content ═════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- Top bar: breadcrumb, actions, window buttons -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Command="{Binding ExportReportCommand}"
                                    IsEnabled="{Binding HasResult}" WindowChrome.IsHitTestVisibleInChrome="True"
                                    ToolTip="{l:Tr toolbar.report_tooltip}" AutomationProperties.Name="{l:Tr toolbar.report_automation_name}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:Tr toolbar.report_button}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenFolderCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:Tr toolbar.scan_button}" />
                                    <TextBlock Text="{l:Tr global.shortcut_open}" Margin="10,0,0,0" Foreground="#C7C8FF" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Command="{Binding GoUpCommand}" ToolTip="{l:Tr toolbar.go_up_tooltip}"
                                    IsEnabled="{Binding HasResult}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,6,0" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,6,0"
                                       Visibility="{Binding HasResult, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}" WindowChrome.IsHitTestVisibleInChrome="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:Crumb">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="CrumbButton" Style="{StaticResource LinkButton}" Content="{Binding Label}"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" MaxWidth="220" />
                                            <TextBlock x:Name="Separator" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="2,0" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="CrumbButton" Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Setter TargetName="CrumbButton" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:Tr toolbar.no_scan_loaded}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding HasResult, Converter={StaticResource Hidden}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Error banner -->
                <Border Grid.Row="1" Margin="16,12,16,0" Padding="12,8" CornerRadius="8" Background="#33E66767" BorderBrush="#66E66767" BorderThickness="1"
                        Visibility="{Binding ErrorText, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                                Content="&#xE711;" Command="{Binding DismissErrorCommand}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Stats strip -->
                <Border Grid.Row="2" Margin="16,14,16,0" Style="{StaticResource Card}" Padding="6,10"
                        Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{Binding Stats}" ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Items dock left; the last one fills the rest and trims when space runs out. -->
                                <DockPanel LastChildFill="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:Stat">
                                <!-- Fixed slot widths keep the strip still while clicking through the tree. -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,0" Margin="0,2">
                                    <StackPanel Width="{Binding Width}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" FontWeight="Normal" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" behaviors:TrimmedToolTip.IsEnabled="True" />
                                        <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" behaviors:TrimmedToolTip.IsEnabled="True" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Main area -->
                <Grid Grid.Row="3" Margin="16,14,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="430" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Tree list -->
                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <ListView x:Name="TreeList" ItemsSource="{Binding Tree.Rows}" SelectedItem="{Binding SelectedRow}"
                                  SelectionMode="Single" ContextMenu="{StaticResource RowMenu}" Margin="0,0,0,4"
                                  GridViewColumnHeader.Click="OnTreeHeaderClick" MouseDoubleClick="OnTreeDoubleClick"
                                  PreviewKeyDown="OnTreeKeyDown">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="ToolTip" Value="{Binding Warning}" />
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Width="380">
                                        <GridViewColumnHeader Content="{l:Tr tree.column_name}" Tag="Name" />
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:NodeRow">
                                                <DockPanel>
                                                    <Border Width="{Binding Indent}" />
                                                    <Grid Width="20" Margin="0,0,4,0">
                                                        <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded}"
                                                                      Visibility="{Binding CanExpand, Converter={StaticResource Visible}}" />
                                                    </Grid>
                                                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Width="22" FontSize="14"
                                                               Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                                               Foreground="{Binding Icon, Converter={StaticResource IconBrush}}" />
                                                    <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                                                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="88">
                                        <GridViewColumnHeader Content="{l:Tr tree.column_size}" Tag="Size" HorizontalContentAlignment="Right" />
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:NodeRow">
                                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="136" CellTemplate="{StaticResource ShareBar}">
                                        <GridViewColumnHeader Content="{l:Tr tree.column_share}" Tag="Size" />
                                    </GridViewColumn>
                                    <GridViewColumn Width="80">
                                        <GridViewColumnHeader Content="{l:Tr tree.column_files}" Tag="Files" HorizontalContentAlignment="Right" />
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:NodeRow">
                                                <TextBlock Text="{Binding FilesText}" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="68">
                                        <GridViewColumnHeader Content="{l:Tr tree.column_folders}" Tag="Files" HorizontalContentAlignment="Right" />
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:NodeRow">
                                                <TextBlock Text="{Binding FoldersText}" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="122">
                                        <GridViewColumnHeader Content="{l:Tr tree.column_modified}" Tag="Modified" />
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:NodeRow">
                                                <TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

                    <!-- Detail panel -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                        <Grid>
                            <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                                <TabItem Header="{l:Tr details.tab_chart}">
                                    <Grid Margin="16,14,16,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="200" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding ChartTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ChartSubtitle}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                            <TextBlock Text="{l:Tr chart.presentation}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                            <UniformGrid Rows="1">
                                                <RadioButton Style="{StaticResource TileRadio}" IsChecked="{Binding ChartMode, Converter={StaticResource Equals}, ConverterParameter=Donut}" AutomationProperties.Name="{l:Tr chart.mode_donut}">
                                                    <StackPanel>
                                                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="3"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                              Data="M9,1.5 A7.5,7.5 0 1 1 1.5,9" />
                                                        <TextBlock Text="{l:Tr chart.mode_donut}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource TileRadio}" IsChecked="{Binding ChartMode, Converter={StaticResource Equals}, ConverterParameter=Pie}" AutomationProperties.Name="{l:Tr chart.mode_pie}">
                                                    <StackPanel>
                                                        <Path Width="18" Height="18" Stretch="Uniform"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                              Data="M10,0 A10,10 0 1 1 0,10 L10,10 Z M8,0 L8,8 L0,8 A8,8 0 0 1 8,0 Z" />
                                                        <TextBlock Text="{l:Tr chart.mode_pie}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource TileRadio}" IsChecked="{Binding ChartMode, Converter={StaticResource Equals}, ConverterParameter=Bar}" AutomationProperties.Name="{l:Tr chart.mode_bar}">
                                                    <StackPanel>
                                                        <Path Width="18" Height="18" Stretch="Uniform"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                              Data="M0,0 H18 V4 H0 Z M0,7 H12 V11 H0 Z M0,14 H7 V18 H0 Z" />
                                                        <TextBlock Text="{l:Tr chart.mode_bar}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource TileRadio}" Margin="0" IsChecked="{Binding ChartMode, Converter={StaticResource Equals}, ConverterParameter=Treemap}" AutomationProperties.Name="{l:Tr chart.mode_treemap}">
                                                    <StackPanel>
                                                        <Path Width="18" Height="18" Stretch="Uniform"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                              Data="M0,0 H10 V18 H0 Z M12,0 H18 V9 H12 Z M12,11 H18 V18 H12 Z" />
                                                        <TextBlock Text="{l:Tr chart.mode_treemap}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>
                                            <CheckBox Style="{StaticResource Switch}" Margin="2,12,0,0" Content="{l:Tr chart.show_free_space}"
                                                      IsChecked="{Binding IncludeFreeSpace}"
                                                      Visibility="{Binding CanShowFreeSpace, Converter={StaticResource Visible}}" />
                                        </StackPanel>

                                        <controls:SizeChart Grid.Row="2" Margin="0,12,0,4" Items="{Binding ChartItems}" Mode="{Binding ChartMode}"
                                                            ItemCommand="{Binding NavigateCommand}"
                                                            SurfaceBrush="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                                            SecondaryForeground="{StaticResource TextSecondaryBrush}"
                                                            TooltipBackground="{StaticResource SurfaceRaisedBrush}"
                                                            TooltipBorderBrush="{StaticResource BorderStrongBrush}"
                                                            HoverBrush="{StaticResource RowHoverBrush}" CenterLabel="{l:Tr chart.center_used}" />

                                        <!-- Legend (direct labels replace it in bar mode) -->
                                        <ScrollViewer Grid.Row="3" MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding ShowLegend, Converter={StaticResource Visible}}">
                                            <ItemsControl ItemsSource="{Binding ChartItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ChartItem">
                                                        <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="0"
                                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" IsHitTestVisible="{Binding CanNavigate}">
                                                            <DockPanel>
                                                                <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,10,0" />
                                                                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding ShareText}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <TextBlock DockPanel.Dock="Right" Width="86" TextAlignment="Right" Text="{Binding SizeText}" />
                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="{l:Tr details.tab_file_types}">
                                    <ListView ItemsSource="{Binding Extensions}" Margin="4,10,4,4">
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="False">
                                                <GridViewColumn Header="{l:Tr details.column_type}" Width="84">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="vm:ExtensionRow">
                                                            <TextBlock Text="{Binding Extension}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="72">
                                                    <GridViewColumnHeader Content="{l:Tr details.column_files}" HorizontalContentAlignment="Right" />
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="vm:ExtensionRow">
                                                            <TextBlock Text="{Binding CountText}" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="84">
                                                    <GridViewColumnHeader Content="{l:Tr details.column_size}" HorizontalContentAlignment="Right" />
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="vm:ExtensionRow">
                                                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" FontWeight="SemiBold" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{l:Tr details.column_share}" Width="150" CellTemplate="{StaticResource ShareBar}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </TabItem>

                                <TabItem Header="{l:Tr details.tab_top_files}">
                                    <ListView x:Name="TopList" ItemsSource="{Binding TopFiles}" Margin="4,10,4,4" MouseDoubleClick="OnTopFileDoubleClick">
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{l:Tr context_menu.show_in_tree}" Command="{Binding NavigateCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr context_menu.open}" Command="{Binding OpenItemCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr context_menu.show_in_explorer}" Command="{Binding ShowInExplorerCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr context_menu.copy_path}" Command="{Binding CopyPathCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="{l:Tr context_menu.move_to_recycle_bin}" Foreground="{StaticResource DangerBrush}" Command="{Binding RecycleCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="False">
                                                <GridViewColumn Width="36">
                                                    <GridViewColumnHeader Content="#" HorizontalContentAlignment="Right" />
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="vm:FileRow">
                                                            <TextBlock Text="{Binding Rank}" TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{l:Tr details.column_file}" Width="190">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="vm:FileRow">
                                                            <StackPanel ToolTip="{Binding Folder}">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="86">
                                                    <GridViewColumnHeader Content="{l:Tr details.column_size}" HorizontalContentAlignment="Right" />
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="vm:FileRow">
                                                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" FontWeight="SemiBold" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{l:Tr details.column_modified}" Width="112">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="vm:FileRow">
                                                            <TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </TabItem>

                                <TabItem Header="{l:Tr details.tab_file_age}">
                                    <StackPanel Margin="16,16,16,12">
                                        <TextBlock Text="{l:Tr details.file_age_title}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{l:Tr details.file_age_description}"
                                                   Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,14" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding AgeRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:AgeRow">
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="132" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                        <Grid x:Name="Track" Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                            <Border Background="{StaticResource DataBrush}" CornerRadius="0,4,4,0" HorizontalAlignment="Left">
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{StaticResource FractionWidth}">
                                                                        <Binding Path="Relative" />
                                                                        <Binding Path="ActualWidth" ElementName="Track" />
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                            <TextBlock>
                                                                <Run Text="{Binding SizeText, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="{Binding ShareText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <ContentControl Style="{StaticResource Spinner}" Width="28" Height="28" Margin="0,16,16,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Visibility="{Binding IsComputingDetails, Converter={StaticResource Visible}}" />

                            <TextBlock Text="{l:Tr details.select_folder_hint}" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasResult, Converter={StaticResource Hidden}}" />
                        </Grid>
                    </Border>

                    <!-- Empty state -->
                    <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Visibility="{Binding ShowEmptyState, Converter={StaticResource Visible}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="32" Foreground="{StaticResource AccentHoverBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{l:Tr empty_state.title}" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0" HorizontalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Style="{StaticResource Muted}"
                                       Text="{l:Tr empty_state.description}" />
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" HorizontalAlignment="Center" Padding="18,8"
                                    Command="{Binding OpenFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:Tr empty_state.choose_folder}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Scan progress overlay -->
                    <Border Grid.ColumnSpan="3" Background="#D9181B24" CornerRadius="10"
                            Visibility="{Binding IsScanning, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceRaisedBrush}" Width="480" Padding="28,24"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource Spinner}" Width="36" Height="36" Margin="0,0,16,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr scan.running_title}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ScanPath}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <UniformGrid Columns="4" Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr scan.files}" Style="{StaticResource SectionLabel}" FontWeight="Normal" />
                                        <TextBlock Text="{Binding ProgressFiles}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr scan.folders}" Style="{StaticResource SectionLabel}" FontWeight="Normal" />
                                        <TextBlock Text="{Binding ProgressFolders}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr scan.size}" Style="{StaticResource SectionLabel}" FontWeight="Normal" />
                                        <TextBlock Text="{Binding ProgressSize}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr scan.duration}" Style="{StaticResource SectionLabel}" FontWeight="Normal" />
                                        <TextBlock Text="{Binding ProgressElapsed}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                                <Border Background="{StaticResource WindowBrush}" CornerRadius="6" Padding="10,7" Margin="0,20,0,0">
                                    <TextBlock Text="{Binding ProgressCurrent}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Style="{StaticResource OutlineButton}" Content="{l:Tr global.cancel}" HorizontalAlignment="Right" Margin="0,18,0,0"
                                        Command="{Binding CancelScanCommand}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- Status bar -->
                <DockPanel Grid.Row="4" Margin="18,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xEA18;" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:Tr status_bar.standard_user}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                            <Setter Property="Text" Value="{l:Tr status_bar.administrator}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
